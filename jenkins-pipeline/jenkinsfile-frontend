pipeline {
    agent any 
    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }
    environment  {
        SCANNER_HOME=tool 'sonar-scanner'
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO_FRONTEND')
        AWS_DEFAULT_REGION = 'us-west-2'
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main', credentialsId: 'GITHUB', url: 'https://github.com/shilpi-code/three-tier-devsecops-project.git'
            }
        }
        stage('Sonarqube Analysis') {
            steps {
                dir('app-code/frontend/notes-frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh ''' 
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectKey=frontend \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=http://35.90.64.60:9000 \
                            -Dsonar.login=sqp_4d5ebee546a5f4595f8e04a85377b9d156bdf5b6
                        '''
                    }
                }
            }
        }
        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('app-code/frontend/notes-frontend') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }
        stage("Docker Image Build") {
            steps {
                script {
                    dir('app-code/frontend/notes-frontend') {
                            sh 'docker system prune -f'
                            sh 'docker container prune -f'
                            sh 'docker build -t ${AWS_ECR_REPO_NAME} .'
                    }
                }
            }
        }
        stage("ECR Image Pushing") {
            steps {
                script {
                    sh '''
                        aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | \
                        docker login --username AWS --password-stdin ${REPOSITORY_URI}

                        docker tag ${AWS_ECR_REPO_NAME}:latest \
                        ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}

                        docker tag ${AWS_ECR_REPO_NAME}:latest \
                        ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:latest

                        docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}

                        docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:latest
                    '''
                }
            }
        }
        stage("TRIVY Image Scan") {
            steps {
                sh 'trivy image ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:latest > trivyimage.txt' 
            }
        }
    
    stage('Update Deployment file') {
        environment {
            GIT_REPO_NAME = "three-tier-devsecops-project"
            GIT_USER_NAME = "shilpi-code"
        }

        steps {
            dir('kubernetes-manifests/frontend') {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "shilpijainwork@gmail.com"
                        git config user.name "shilpi-code"

                        echo "Jenkins Build Number: ${BUILD_NUMBER}"

                        echo "Current image:"
                        grep "image:" deployment.yaml

                        imageTag=$(grep -oP '(?<=frontend:)[^ ]+' deployment.yaml)

                        echo "Current image tag: ${imageTag}"
                        echo "New image tag: ${BUILD_NUMBER}"

                        sed -i "s/${AWS_ECR_REPO_NAME}:${imageTag}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}/" deployment.yaml

                        echo "Updated image:"
                        grep "image:" deployment.yaml

                        git add deployment.yaml

                        git commit -m "Update deployment Image to version ${BUILD_NUMBER}"

                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                    '''
                }
            }
        }
    }   
    }
}